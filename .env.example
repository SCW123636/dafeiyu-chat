# 复制成 .env 再填值。B站凭证：Chrome F12 -> Application -> Cookies -> https://www.bilibili.com
BILI_SESSDATA=
BILI_JCT=
BILI_UID=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash

# QQ 机器人（NapCat 反向 WS）
QQ_WS_PORT=3001
QQ_WS_TOKEN=
# NapCat OneBot HTTP（QQ空间读写用），默认 http://127.0.0.1:3000
QQ_ONEBOT_HTTP=
# 你自己的 QQ 号；只有这个号能在私聊里用 /空间发 和 /空间确认
QQ_OWNER_ID=
# 新好友申请自动通过（填 0 关掉），以及每天最多自动通过几条
QQ_AUTO_APPROVE=1
QQ_APPROVE_MAX=5
# 通过后隔多少秒发第一句自介（实际会再加 0-60 秒随机）
QQ_GREET_DELAY=30
# 挂机补回复：重启/重连后，翻最近会话把没回的消息都补一句（填 0 关掉）
QQ_CATCHUP=1
# 只看多少小时以内的消息；这个窗口内有多少人就补多少人，不限人数
QQ_CATCHUP_WINDOW=24
# 消息至少放了多久才算「没回」（秒），太新的留给实时对话
QQ_CATCHUP_MIN_AGE=120
# 每条之间隔多少秒（实际会再加 0-40 秒随机），别连着发
QQ_CATCHUP_DELAY=20
# 翻多少个最近会话来找漏回的消息
QQ_CATCHUP_SCAN=20
# 聊天手感：同一个人连发几条时，等多久合并成一次回复（秒），以及最长等多久
QQ_DEBOUNCE=1.8
QQ_DEBOUNCE_MAX=8
# 发送时是否显示「正在输入」（NapCat set_input_status）
QQ_TYPING=1
# 是否按每人的情绪状态调整语气（存本地 SQLite，24 小时自动复位）
QQ_MOOD=1
